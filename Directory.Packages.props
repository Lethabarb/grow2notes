<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A version below also applies where the package comes in only transitively, so the Security group's pins
         reach the packages that ask for older versions. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.4" />
    <!-- Microsoft.Data.SqlClient asks for Azure.Identity 1.17.1, which defines its own credential types. From 1.21.0
         the package only forwards them to Azure.Core, which the Key Vault package brings in at 1.61, so a lower
         Azure.Identity would put a second copy of every credential type in the app. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <!-- The 6.1 line that EF Core 10's SQL Server provider uses; it keeps managed-identity authentication built in
         (design.md §7.5, §9.4). -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!-- Transitive packages pinned past high-severity advisories, which fail the restore (Directory.Build.props).
       Microsoft.Data.SqlClient 6.1.7, the newest 6.1, asks for Pkcs 9.0.11, and Microsoft.AspNetCore.DataProtection
       10.0.12 for Xml and Pkcs 10.0.12; 10.0.13 fixes GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6,
       GHSA-c399-9853-6jmj and GHSA-r955-8q5j-3h83. -->
  <ItemGroup Label="Security">
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!-- xUnit.net v3 without Microsoft Testing Platform, run through VSTest: the .NET 10 SDK's default dotnet test
         mode, which takes `dotnet test Grow2Notes.slnx` as written. The plain xunit.v3 package brings in Microsoft
         Testing Platform v2, which stops dotnet test in that mode. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.1" />
  </ItemGroup>

</Project>
